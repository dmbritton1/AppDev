    {
      "name": "QuietMind",
      "niche": "Micro-journaling for anxiety",
      "problem": "People with anxiety need quick ways to process thoughts but find traditional journaling overwhelming",
      "targetUser": "Young adults dealing with anxiety who want a low-friction mental health tool",
      "coreFeatures": ["One-tap mood logging", "Guided micro-prompts", "Pattern insights", "Breathing exercises"],
      "realDependencies": ["Health API integration", "Push notifications", "Data encryption"],
      "emulationStrategy": "Local mood data with animated breathing UI and mock insights",
      "html": "<!DOCTYPE html><html lang='en'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width,initial-scale=1.0'><title>QuietMind</title><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:system-ui,sans-serif;background:linear-gradient(180deg,#faf5ff,#f3e8ff);color:#1c1917;min-height:100vh}.header{padding:20px 24px;display:flex;justify-content:space-between;align-items:center}.header h1{font-size:22px;font-weight:700;color:#7c3aed}.header-sub{font-size:13px;color:#a78bfa}.container{max-width:480px;margin:0 auto;padding:0 20px 40px}.greeting{text-align:center;margin-bottom:32px}.greeting h2{font-size:24px;font-weight:700;color:#581c87;margin-bottom:4px}.greeting p{color:#9333ea;font-size:14px}.mood-section{background:white;border-radius:20px;padding:24px;margin-bottom:20px;box-shadow:0 2px 8px rgba(124,58,237,0.08);text-align:center}.mood-section h3{font-size:14px;color:#7c3aed;margin-bottom:16px;font-weight:600}.mood-row{display:flex;justify-content:center;gap:12px;margin-bottom:16px}.mood-btn{width:52px;height:52px;border-radius:50%;border:2px solid #e9d5ff;background:white;font-size:24px;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;justify-content:center}.mood-btn:hover{transform:scale(1.15);border-color:#7c3aed;box-shadow:0 0 0 4px rgba(124,58,237,0.1)}.mood-btn.selected{border-color:#7c3aed;background:#f5f3ff;transform:scale(1.1)}.prompt-card{background:white;border-radius:20px;padding:24px;margin-bottom:20px;box-shadow:0 2px 8px rgba(124,58,237,0.08)}.prompt-card h3{font-size:14px;color:#7c3aed;margin-bottom:12px;font-weight:600}.prompt-text{background:#faf5ff;border-radius:12px;padding:16px;font-size:15px;color:#6b21a8;line-height:1.6;font-style:italic;margin-bottom:14px}.prompt-input{width:100%;border:1px solid #e9d5ff;border-radius:12px;padding:14px;font-size:14px;font-family:inherit;resize:none;outline:none;min-height:80px;transition:border-color 0.2s}.prompt-input:focus{border-color:#7c3aed}.prompt-input::placeholder{color:#c4b5fd}.breathe-card{background:linear-gradient(135deg,#7c3aed,#a855f7);border-radius:20px;padding:28px;text-align:center;color:white;margin-bottom:20px;cursor:pointer}.breathe-card h3{font-size:16px;margin-bottom:8px}.breathe-card p{font-size:13px;opacity:0.85}.breathe-circle{width:80px;height:80px;border-radius:50%;border:3px solid rgba(255,255,255,0.4);margin:20px auto;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:600;animation:pulse 4s ease-in-out infinite}.insights{background:white;border-radius:20px;padding:24px;box-shadow:0 2px 8px rgba(124,58,237,0.08)}.insights h3{font-size:14px;color:#7c3aed;margin-bottom:14px;font-weight:600}.insight-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #faf5ff}.insight-row:last-child{border:none}.insight-label{font-size:13px;color:#78716c}.insight-value{font-size:14px;font-weight:600;color:#581c87}.streak{display:flex;gap:4px;margin-top:12px;justify-content:center}.streak-dot{width:24px;height:24px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:10px}.streak-active{background:#7c3aed;color:white}.streak-inactive{background:#f3e8ff;color:#c4b5fd}@keyframes pulse{0%,100%{transform:scale(1);opacity:0.7}50%{transform:scale(1.15);opacity:1}}.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(10px);background:#7c3aed;color:white;padding:12px 24px;border-radius:24px;font-size:14px;opacity:0;transition:all 0.3s;pointer-events:none;z-index:50}.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}</style></head><body><div class='header'><div><h1>QuietMind</h1><div class='header-sub'>Your daily check-in</div></div></div><div class='container'><div class='greeting'><h2>Good morning</h2><p>Friday, May 23</p></div><div class='mood-section'><h3>How are you feeling right now?</h3><div class='mood-row'><button class='mood-btn' onclick='selectMood(this,\"Struggling\")'>😔</button><button class='mood-btn' onclick='selectMood(this,\"Low\")'>😕</button><button class='mood-btn' onclick='selectMood(this,\"Okay\")'>😐</button><button class='mood-btn' onclick='selectMood(this,\"Good\")'>🙂</button><button class='mood-btn' onclick='selectMood(this,\"Great\")'>😊</button></div></div><div class='prompt-card'><h3>Micro-journal</h3><div class='prompt-text'>What is one thing you can control today?</div><textarea class='prompt-input' placeholder='Write a few words...' oninput='checkSave(this)'></textarea><div id='saveStatus' style='text-align:right;margin-top:8px;font-size:12px;color:#a78bfa'></div></div><div class='breathe-card' onclick='startBreathe()'><h3>Box Breathing</h3><p>Tap to start a 1-minute guided session</p><div class='breathe-circle' id='breatheCircle'>4s</div></div><div class='insights'><h3>This Week</h3><div class='insight-row'><span class='insight-label'>Average Mood</span><span class='insight-value'>Good 🙂</span></div><div class='insight-row'><span class='insight-label'>Entries This Week</span><span class='insight-value'>5 of 7</span></div><div class='insight-row'><span class='insight-label'>Most Common Feeling</span><span class='insight-value'>Calm</span></div><div class='streak'><div class='streak-dot streak-active'>M</div><div class='streak-dot streak-active'>T</div><div class='streak-dot streak-active'>W</div><div class='streak-dot streak-active'>T</div><div class='streak-dot streak-active'>F</div><div class='streak-dot streak-inactive'>S</div><div class='streak-dot streak-inactive'>S</div></div></div></div><div class='toast' id='toast'></div><script>function selectMood(el,label){document.querySelectorAll('.mood-btn').forEach(function(b){b.classList.remove('selected')});el.classList.add('selected');showToast('Mood logged: '+label)}function checkSave(el){if(el.value.length>10){document.getElementById('saveStatus').textContent='Saved'}else{document.getElementById('saveStatus').textContent=''}}function startBreathe(){var c=document.getElementById('breatheCircle');var phases=['Inhale','Hold','Exhale','Hold'];var i=0;showToast('Breathing exercise started');var interval=setInterval(function(){c.textContent=phases[i%4];i++;if(i>16)clearInterval(interval)},1000)}function showToast(msg){var t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(function(){t.classList.remove('show')},2000)}</script></body></html>"
    }
